# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# 아래는 모두 서버에서만 쓰는 비밀 키입니다. 절대 VITE_ 를 붙이지 마세요.
DATA_GO_KR_KEY=
# 아래 두 줄은 브라우저에 들어가도 되는 공개 값입니다 (anon key 만! service_role 키는 절대 넣지 마세요)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 카카오 지도 JavaScript 키 (브라우저용 공개 키. 카카오 개발자 사이트에서 사이트 주소를 등록해야 동작)
VITE_KAKAO_JS_KEY=

PIXABAY_KEY=
NCPMS_API_KEY=
# KAMIS(농산물유통정보) 오픈API: 인증키와 요청자 아이디 (소매가격 조회용, 서버에서만 사용)
KAMIS_API_KEY=
KAMIS_API_ID=
KAKAO_REST_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# (선택) 주 모델이 사용량 한도로 실패하면 순서대로 다시 시도할 예비 모델. 안 적으면 gemini:gemini-3.5-flash (Claude 사용 시에는 gemini-3.5-flash-lite)
# MODEL_FALLBACK=gemini:gemini-3.5-flash,anthropic:haiku
